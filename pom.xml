<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>com.yigalaxy</groupId>
    <artifactId>yiguixingtu</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>yiguixingtu</name>
    <description>yiguixingtu</description>
    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>
    <properties>
        <java.version>17</java.version>
    </properties>
    <dependencies>
        <!-- ==================== Web 相关 ==================== -->
        <!-- Spring Boot Web 依赖 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <!-- ==================== 测试相关 ==================== -->
        <!-- Spring Boot Web 测试依赖 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- ==================== 容器化集成测试（Testcontainers） ==================== -->
        <!--
          【用途】测试启动时自己拉起 MySQL / Redis 容器，用完销毁。
          这样 "clone 下来就能跑测试"、"CI 上也能跑"，不再依赖本机先
          docker compose up -d —— 见 AbstractIntegrationTest 的类注释。

          【⚠️ 两个容易踩的坑，都记在这里】
          ① Testcontainers 2.x 把模块名统一加了 testcontainers- 前缀。
             旧写法 org.testcontainers:mysql 在 2.x 里【不存在】，
             而且报出来的错是 "version is missing"（看着像版本没管好，
             实际是坐标写错了）—— 正确坐标是 org.testcontainers:testcontainers-mysql。
             版本由 Spring Boot 的 BOM 管（testcontainers-bom 2.0.5），不用手写。
          ② 类所在的包也换了：MySQLContainer 从 org.testcontainers.containers
             挪到了 org.testcontainers.mysql。

          【为什么不加 testcontainers-junit-jupiter】容器用的是 singleton
          container pattern（static 代码块启动），不依赖 @Testcontainers 扩展。
          【为什么 Redis 不用专门的模块】官方 BOM 里没有 redis 模块，
          Redis 只要暴露一个端口，GenericContainer 完全够用。
        -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-mysql</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- ==================== ORM 框架（MyBatis-Plus） ==================== -->
        <!-- MyBatis-Plus Spring Boot 4 启动器 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
            <version>3.5.17</version>
        </dependency>
        <!-- MyBatis-Plus SQL 解析器（分页/多租户支持） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
            <version>3.5.17</version>
        </dependency>

        <!-- ==================== 数据库驱动（MySQL） ==================== -->
        <!-- MySQL 驱动 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ==================== 数据库版本化迁移（Flyway） ==================== -->
        <!--
          【⚠️ 这里要三个依赖，少一个都不行 —— 踩过坑，记录下来】
          ① spring-boot-flyway：Spring Boot 的 Flyway 自动配置。
             Spring Boot 4 把自动配置按技术拆成了独立模块（spring-boot-jdbc、
             spring-boot-data-redis 同理），它不再包含在 spring-boot-autoconfigure 里。
             只加 ② ③ 的话，编译和启动都不报错，但 Flyway 就是【一声不响地不执行】——
             flyway_schema_history 表根本不会出现，最难查的就是这种"静默失效"。
          ② flyway-core：Flyway 引擎本身。
          ③ flyway-mysql：Flyway 10 起把各数据库方言拆成了独立模块，
             核心包不含 MySQL 支持，少了它会报 "Unsupported Database: MySQL"。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>

        <!-- ==================== 缓存（Redis） ==================== -->
        <!-- Spring Boot Redis 依赖 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- ==================== 认证安全（Spring Security + JWT） ==================== -->
        <!-- 完整 Spring Security（含 BCrypt、过滤器链、认证管理器） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <!-- JWT API（编译期依赖） -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.12.6</version>
        </dependency>
        <!-- JWT 实现（运行时依赖） -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>
        <!-- JWT JSON 序列化（运行时依赖） -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>

        <!-- ==================== 接口文档（OpenAPI/Swagger） ==================== -->
        <!-- springdoc 自动生成 OpenAPI 规范，供 Apifox 同步 -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>3.0.0</version>
        </dependency>

        <!-- ==================== Lombok（编译期生成getter/setter等） ==================== -->
        <!-- Lombok：用注解自动生成 getter/setter/toString 等，减少样板代码 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ==================== 参数校验（@Valid/@NotBlank） ==================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- ==================== 限流与熔断降级（Resilience4j） ==================== -->
        <!--
          【用途】给接口加"应用层限流"：某个接口被刷得太狠时直接拒绝多余请求，
          保护后面的数据库和 Redis 不被打穿。

          【⚠️ 坐标为什么是 spring-boot4 而不是常见的 spring-boot3】
          Resilience4j 为每个 Spring Boot 大版本单独出了一个 starter
          （spring-boot2 / spring-boot3 / spring-boot4），因为自动配置要分别适配。
          本项目是 Boot 4.1.1，**必须用 spring-boot4 这个**：
          它的 POM 依赖的是 spring-core 7.x + spring-boot-autoconfigure 4.x，正好对上；
          写成 spring-boot3 会拿 Boot 3 时代的适配层跑 Boot 4，属于能编译但行为不保证。

          【它带来了什么】
            · @RateLimiter / @CircuitBreaker / @Retry / @Bulkhead 这些注解
              以及它们的 AOP 切面 —— **都是库自带的，不需要自己写 @Aspect**
            · resilience4j-micrometer：限流/熔断的状态会自动变成 Micrometer 指标，
              于是在 /actuator/prometheus 里能直接看到"被限流拒绝了多少次"，
              不用自己埋点
        -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-spring-boot4</artifactId>
            <version>2.4.0</version>
        </dependency>

        <!--
          【为什么显式加 AOP starter，而不是指望传递依赖】
          Resilience4j 的注解靠 AspectJ 切面生效，需要两个前提：
            ① aspectjweaver 在 classpath 上
            ② Spring 开启 AOP 自动代理（Boot 的 AopAutoConfiguration 会开，
               但它本身就以"classpath 上有 aspectjweaver"为前提）
          当前这点确实满足（aspectjweaver 通过 micrometer-tracing 传进来了），
          但那是【别人家的传递依赖】—— 哪天链路追踪换了实现，限流就会悄悄失效，
          而且失效得毫无征兆：注解还在，就是不生效。
          显式声明之后，这条依赖变成我们自己的责任，不会再被别人的改动带走。

          ⚠️【注意坐标在 Boot 4 里改名了】
            以前叫 spring-boot-starter-aop，Boot 4 改成了 spring-boot-starter-aspectj。
            写旧名字不会报"找不到"，而是报 'dependencies.dependency.version' ...
            is missing（因为新版 BOM 里已经不管那个 artifact 的版本了），
            看起来像"忘了写 version"，其实是用错了坐标 —— 又一次和 Boot 4 的
            模块调整打交道（前面 Flyway、micrometer-tracing、resilience4j 都遇到过）。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aspectj</artifactId>
        </dependency>

        <!-- ==================== 指标暴露（Prometheus） ==================== -->
        <!--
          【用途】把应用内部的状态暴露成 Prometheus 能抓的格式（/actuator/prometheus）。
          装上这个 registry 之后，下面这些指标是【自动】就有的，不用写一行代码：
            · JVM 内存 / GC / 线程数
            · HTTP 接口的请求量、耗时分布（http_server_requests_seconds）
            · HikariCP 连接池的活跃/空闲连接数
            · Redis 连接工厂、Tomcat 线程池
          这就是"用现成的而不是自研"：想要接口耗时统计，
          正确的做法是让框架把指标吐出来，而不是自己写个拦截器记时间戳。

          【为什么 version 不写】版本由 spring-boot-starter-parent 统一管理
          （当前 Boot 4.1.1 → micrometer 1.17.1）。
          手写一个版本号反而会和 Boot 的其它 micrometer 组件对不上。

          【⚠️ 又是 Boot 4 拆模块的教训，这里提前说清楚】
          registry 只是"把数字变成 Prometheus 文本格式"的编码器。
          真正"什么时候采集、采集哪些"的自动配置在
          spring-boot-starter-micrometer-metrics 里（已由 actuator 带进来）。
          两者少任何一个的表现都是【静默的】：编译通过、启动成功，
          只是 /actuator/prometheus 这个端点是 404 ——
          所以必须有测试去访问它，而不能只看"启动没报错"。
        -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- ==================== 对象存储（阿里云 OSS） ==================== -->
        <!--
          【用途】把文章封面图传到 OSS，而不是存在 ECS 的本地磁盘上。
          为什么不用本地磁盘：ECS 的盘容量有限，而且一旦换机器或重建容器，
          本地图片就丢了；OSS 还自带 CDN 加速与图片处理能力，成本也低。

          【它是不是必须的】不是。项目默认用本地磁盘（app.upload.storage=local），
          这样本地开发与测试不需要任何 OSS 凭据就能跑通整个上传流程；
          只有生产环境把它设成 oss 时才会走到这个 SDK。
          但依赖写在默认（compile）作用域：接口与实现在同一个 jar 里，
          不能指望部署时再补一个 jar 进镜像。
        -->
        <dependency>
            <groupId>com.aliyun.oss</groupId>
            <artifactId>aliyun-sdk-oss</artifactId>
            <version>3.18.1</version>
        </dependency>

        <!-- ==================== 链路追踪（Micrometer Tracing + Brave） ==================== -->
        <!--
          【用途】给每个请求生成一个 traceId，并打进日志。
          出问题时，把前端报错里带的 traceId 拿到日志里一搜，
          这次请求经过的所有日志行就都在眼前了 —— 这也是前端 w5.3 要做的事。

          【⚠️ 为什么是 spring-boot-micrometer-tracing-brave 而不是 micrometer-tracing-bridge-brave】
          和 Flyway 那次一模一样的坑：Spring Boot 4 把自动配置按技术拆成了独立模块，
          只加裸的 bridge 依赖的话，编译能过、启动也不报错，
          但 traceId 就是【不会出现】——又是一个静默失效。
          spring-boot-micrometer-tracing-brave 里同时带了自动配置与 Brave 实现，
          是这个版本下的正确入口。

          【为什么选 Brave 而不是 OpenTelemetry】
          本项目只是把 traceId 打进日志、方便串联排查，不需要把数据导出到
          Jaeger / Zipkin 那类后端。Brave 依赖更轻、够用；
          真接了链路追踪服务再换 opentelemetry 那一支即可（BOM 里有对应模块）。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-micrometer-tracing-brave</artifactId>
        </dependency>
        <!--
          【⚠️ 这个依赖是必须的，而且少它不会报错，只会静默失效 —— 实测踩过】
          上面那个 spring-boot-micrometer-tracing-brave 只提供
          【Spring Boot 的自动配置】+ micrometer-tracing 的【API】，
          而真正干活的【实现】（Brave 的 tracer、span、MDC 装饰器）在下面这个 bridge 里。
          只加上面那一个的后果（实测）：
            · 编译通过、启动正常、Tracer Bean 也能注入
            · 但请求不会创建 span，日志里的 traceId 永远是空的
            · 响应头里也不会有 X-B3-TraceId
          和 Flyway 那次是同一种坑（spring-boot-flyway + flyway-core + flyway-mysql 三个都要）。
          结论：Boot 4 里凡是被拆成独立模块的技术，
          "Spring Boot 自动配置模块" 与 "厂商实现模块" 往往要【同时】加。
        -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-brave</artifactId>
        </dependency>


    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!--
              ==================== 代码覆盖率（JaCoCo） ====================
              【为什么手写版本号】Spring Boot 4.1.1 的父 POM 只管理了编译、打包、
              failsafe 等插件，jacoco-maven-plugin 不在其中，不写版本会直接构建失败。
              【为什么绑在 verify 而不是 test】覆盖率报告要在所有测试跑完之后才有数据，
              绑在 test 阶段会拿到还没写完的 exec 文件；所以用 `mvn verify` 出报告。
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.13</version>
                <configuration>
                    <!--
                      【为什么只插桩本项目自己的包】
                      ① 覆盖率报告本来就只该统计"我写的代码"，把依赖也算进去没有意义
                      ② 不加这个的话，日志里会出现一大段很吓人的报错：
                         java.lang.instrument.IllegalClassFormatException:
                         Error while instrumenting net/sf/jsqlparser/parser/CCJSqlParserTokenManager
                         ... MethodTooLargeException: Method too large
                         原因：mybatis-plus-jsqlparser 里有个 ANTLR/JavaCC 自动生成的
                         状态机方法，插桩后超过了 JVM 单方法 64KB 的字节码上限。
                         它不会让构建失败（JVM 会忽略插桩失败的类），但会淹没 CI 日志，
                         让人以为构建出了问题 —— 这才是真正要避免的
                    -->
                    <includes>
                        <include>com/yigalaxy/yiguixingtu/**</include>
                    </includes>
                </configuration>
                <executions>
                    <!-- ① 在测试 JVM 上挂 JaCoCo agent，把执行数据写到 target/jacoco.exec -->
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <!-- ② 测试跑完后，把 exec 数据渲染成 HTML/XML 报告 -->
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
