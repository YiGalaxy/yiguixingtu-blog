<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>com.yigalaxy</groupId>
    <artifactId>yiguixingtu</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>yiguixingtu</name>
    <description>yiguixingtu</description>
    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>
    <properties>
        <java.version>17</java.version>
    </properties>
    <dependencies>
        <!-- ==================== Web 相关 ==================== -->
        <!-- Spring Boot Web 依赖 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <!-- ==================== 测试相关 ==================== -->
        <!-- Spring Boot Web 测试依赖 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- ==================== 容器化集成测试（Testcontainers） ==================== -->
        <!--
          【用途】测试启动时自己拉起 MySQL / Redis 容器，用完销毁。
          这样 "clone 下来就能跑测试"、"CI 上也能跑"，不再依赖本机先
          docker compose up -d —— 见 AbstractIntegrationTest 的类注释。

          【⚠️ 两个容易踩的坑，都记在这里】
          ① Testcontainers 2.x 把模块名统一加了 testcontainers- 前缀。
             旧写法 org.testcontainers:mysql 在 2.x 里【不存在】，
             而且报出来的错是 "version is missing"（看着像版本没管好，
             实际是坐标写错了）—— 正确坐标是 org.testcontainers:testcontainers-mysql。
             版本由 Spring Boot 的 BOM 管（testcontainers-bom 2.0.5），不用手写。
          ② 类所在的包也换了：MySQLContainer 从 org.testcontainers.containers
             挪到了 org.testcontainers.mysql。

          【为什么不加 testcontainers-junit-jupiter】容器用的是 singleton
          container pattern（static 代码块启动），不依赖 @Testcontainers 扩展。
          【为什么 Redis 不用专门的模块】官方 BOM 里没有 redis 模块，
          Redis 只要暴露一个端口，GenericContainer 完全够用。
        -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-mysql</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- ==================== ORM 框架（MyBatis-Plus） ==================== -->
        <!-- MyBatis-Plus Spring Boot 4 启动器 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
            <version>3.5.17</version>
        </dependency>
        <!-- MyBatis-Plus SQL 解析器（分页/多租户支持） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
            <version>3.5.17</version>
        </dependency>

        <!-- ==================== 数据库驱动（MySQL） ==================== -->
        <!-- MySQL 驱动 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ==================== 数据库版本化迁移（Flyway） ==================== -->
        <!--
          【⚠️ 这里要三个依赖，少一个都不行 —— 踩过坑，记录下来】
          ① spring-boot-flyway：Spring Boot 的 Flyway 自动配置。
             Spring Boot 4 把自动配置按技术拆成了独立模块（spring-boot-jdbc、
             spring-boot-data-redis 同理），它不再包含在 spring-boot-autoconfigure 里。
             只加 ② ③ 的话，编译和启动都不报错，但 Flyway 就是【一声不响地不执行】——
             flyway_schema_history 表根本不会出现，最难查的就是这种"静默失效"。
          ② flyway-core：Flyway 引擎本身。
          ③ flyway-mysql：Flyway 10 起把各数据库方言拆成了独立模块，
             核心包不含 MySQL 支持，少了它会报 "Unsupported Database: MySQL"。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>

        <!-- ==================== 缓存（Redis） ==================== -->
        <!-- Spring Boot Redis 依赖 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- ==================== 认证安全（Spring Security + JWT） ==================== -->
        <!-- 完整 Spring Security（含 BCrypt、过滤器链、认证管理器） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <!-- JWT API（编译期依赖） -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.12.6</version>
        </dependency>
        <!-- JWT 实现（运行时依赖） -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>
        <!-- JWT JSON 序列化（运行时依赖） -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>

        <!-- ==================== 接口文档（OpenAPI/Swagger） ==================== -->
        <!-- springdoc 自动生成 OpenAPI 规范，供 Apifox 同步 -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>3.0.0</version>
        </dependency>

        <!-- ==================== Lombok（编译期生成getter/setter等） ==================== -->
        <!-- Lombok：用注解自动生成 getter/setter/toString 等，减少样板代码 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ==================== 参数校验（@Valid/@NotBlank） ==================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>


    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!--
              ==================== 代码覆盖率（JaCoCo） ====================
              【为什么手写版本号】Spring Boot 4.1.1 的父 POM 只管理了编译、打包、
              failsafe 等插件，jacoco-maven-plugin 不在其中，不写版本会直接构建失败。
              【为什么绑在 verify 而不是 test】覆盖率报告要在所有测试跑完之后才有数据，
              绑在 test 阶段会拿到还没写完的 exec 文件；所以用 `mvn verify` 出报告。
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.13</version>
                <configuration>
                    <!--
                      【为什么只插桩本项目自己的包】
                      ① 覆盖率报告本来就只该统计"我写的代码"，把依赖也算进去没有意义
                      ② 不加这个的话，日志里会出现一大段很吓人的报错：
                         java.lang.instrument.IllegalClassFormatException:
                         Error while instrumenting net/sf/jsqlparser/parser/CCJSqlParserTokenManager
                         ... MethodTooLargeException: Method too large
                         原因：mybatis-plus-jsqlparser 里有个 ANTLR/JavaCC 自动生成的
                         状态机方法，插桩后超过了 JVM 单方法 64KB 的字节码上限。
                         它不会让构建失败（JVM 会忽略插桩失败的类），但会淹没 CI 日志，
                         让人以为构建出了问题 —— 这才是真正要避免的
                    -->
                    <includes>
                        <include>com/yigalaxy/yiguixingtu/**</include>
                    </includes>
                </configuration>
                <executions>
                    <!-- ① 在测试 JVM 上挂 JaCoCo agent，把执行数据写到 target/jacoco.exec -->
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <!-- ② 测试跑完后，把 exec 数据渲染成 HTML/XML 报告 -->
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
